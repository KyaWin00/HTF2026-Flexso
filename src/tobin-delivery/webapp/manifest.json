{
  "_version": "2.0.0",
  "sap.app": {
    "id": "oakhaven.tobindelivery",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [""],
      "fallbackLocale": ""
    },
    "applicationVersion": { "version": "0.1.0" },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "foodStockService": {
        "uri": "/odata/v4/food-stock/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "display": {
          "semanticObject": "TobinDelivery",
          "action": "display",
          "title": "{{appTitle}}",
          "subTitle": "{{appDescription}}",
          "icon": "sap-icon://ti/truck-delivery",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": { "icon": "sap-icon://ti/truck-delivery" },
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true },
    "fullWidth": true
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "oakhaven.tobindelivery.view.Delivery",
      "type": "XML",
      "id": "delivery"
    },
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": { "sap.ui.core": {}, "sap.m": {}, "sap.f": {} }
    },
    "handleValidation": true,
    "contentDensities": { "compact": true, "cozy": true },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "oakhaven.tobindelivery.i18n.i18n",
          "async": true,
          "supportedLocales": [""],
          "fallbackLocale": ""
        }
      },
      "food": {
        "dataSource": "foodStockService",
        "settings": { "operationMode": "Server", "autoExpandSelect": true, "earlyRequests": true }
      }
    },
    "resources": { "css": [{ "uri": "css/style.css" }] }
  }
}
