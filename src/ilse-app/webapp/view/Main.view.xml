<mvc:View
    controllerName="oakhaven.ilse.controller.Main"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    displayBlock="true"
    height="100%">
    <f:DynamicPage id="page">
        <f:title>
            <f:DynamicPageTitle id="pageTitle">
                <f:heading>
                    <Title id="pageTitleText" text="{i18n>appTitle}" level="H1" />
                </f:heading>
                <f:expandedContent>
                    <Label id="pageSubtitle" text="{i18n>appDescription}" />
                </f:expandedContent>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <!-- Placeholder until we know what this villager needs. -->
            <IllustratedMessage
                id="comingSoon"
                illustrationType="sapIllus-NoData"
                title="{i18n>comingSoonTitle}"
                description="{i18n>comingSoonText}" />
        </f:content>
    </f:DynamicPage>
</mvc:View>
