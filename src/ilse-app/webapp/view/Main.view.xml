<mvc:View
    controllerName="oakhaven.ilse.controller.Main"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    core:require="{ formatMessage: 'sap/base/strings/formatMessage' }"
    displayBlock="true"
    height="100%">
    <f:DynamicPage id="page" toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle id="pageTitle">
                <f:heading>
                    <Title id="pageTitleText" text="{i18n>appTitle}" level="H1" wrapping="false" />
                </f:heading>
                <f:expandedContent>
                    <Label id="pageSubtitle" text="{i18n>pageSubtitle}" />
                </f:expandedContent>
                <f:snappedContent>
                    <Label id="pageSubtitleSnapped" text="{i18n>pageSubtitle}" />
                </f:snappedContent>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox id="content" class="ilseContent">
                <!-- Ilse at her desk, on her old laptop, with time to read. First what we found (in sentences
                     she can tell the council), then WHEN it happened, then the evidence itself. -->
                <HBox id="top" renderType="Bare" class="ilseTop">
                    <!-- What we found, as an investigator's board: the name in the middle, the records it
                         changed in the same minute around it, each with its signs, tied with a string.
                         Built from the data on every load (Bursts, Timeline, SuspiciousRecords). -->
                    <VBox id="report" renderType="Bare" class="ilseReport">
                        <Title id="reportTitle" text="{i18n>reportTitle}" level="H2" titleStyle="H4" class="ilseSection" />
                        <Text id="headline" text="{view>/headline}" class="ilseHeadline" />
                        <core:HTML id="board" content="{view>/boardSvg}" />
                        <!-- The facts in one row: text + icon + colour. -->
                        <HBox id="facts" renderType="Bare" wrap="Wrap" class="ilseFacts">
                            <ObjectStatus id="factRecords" icon="sap-icon://ti/alert-triangle" state="Warning" text="{ parts: ['i18n>factRecords', 'view>/facts/records'], formatter: 'formatMessage' }" />
                            <ObjectStatus id="factNights" icon="sap-icon://ti/moon" state="Information" text="{ parts: ['i18n>factNights', 'view>/facts/nights'], formatter: 'formatMessage' }" />
                            <ObjectStatus id="factContradictions" icon="sap-icon://ti/arrows-exchange" state="Warning" text="{ parts: ['i18n>factContradictions', 'view>/facts/contradictions'], formatter: 'formatMessage' }" />
                            <ObjectStatus id="factMarks" icon="sap-icon://ti/ban" state="Error" text="{ parts: ['i18n>factMarks', 'view>/facts/marks'], formatter: 'formatMessage' }" />
                        </HBox>
                        <Text id="reportCaveat" text="{i18n>reportCaveat}" class="ilseMuted ilseCaveat" />
                    </VBox>

                    <!-- The night clock: one row per day, 0–24 h, the night shaded, suspicious changes red.
                         Ilse: "ik wil kunnen nagaan of het midden november 's nachts begon". -->
                    <VBox id="clock" renderType="Bare" class="ilseClock">
                        <Title id="clockTitle" text="{i18n>clockTitle}" level="H2" titleStyle="H4" class="ilseSection" />
                        <Text id="clockHelp" text="{i18n>clockHelp}" class="ilseMuted" />
                        <core:HTML id="clockSvg" content="{view>/clockSvg}" />
                    </VBox>
                </HBox>

                <IconTabBar id="tabs" expandable="false" applyContentPadding="false" headerBackgroundDesign="Transparent" backgroundDesign="Transparent" class="ilseTabs">
                    <items>
                        <!-- Every record with at least one sign, ALL its reasons, and Ilse's mark. -->
                        <IconTabFilter id="tabSuspicious" key="suspicious" icon="sap-icon://ti/alert-triangle" text="{i18n>tabSuspicious}" count="{view>/suspiciousCount}">
                            <Table
                                id="suspiciousTable"
                                noDataText="{i18n>noSuspicious}"
                                updateFinished=".onSuspiciousUpdated"
                                items="{ path: '/SuspiciousRecords', templateShareable: false }">
                                <columns>
                                    <Column id="colRecord" width="22%"><Text id="colRecordHdr" text="{i18n>colRecord}" /></Column>
                                    <Column id="colValue" width="11%" minScreenWidth="Tablet" demandPopin="true"><Text id="colValueHdr" text="{i18n>colValue}" /></Column>
                                    <Column id="colChanged" width="13%" minScreenWidth="Tablet" demandPopin="true"><Text id="colChangedHdr" text="{i18n>colChanged}" /></Column>
                                    <Column id="colReasons"><Text id="colReasonsHdr" text="{i18n>colReasons}" /></Column>
                                    <Column id="colMark" width="14rem" minScreenWidth="Tablet" demandPopin="true"><Text id="colMarkHdr" text="{i18n>colMark}" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="suspiciousRow" highlight="{= %{marked} ? 'Error' : 'Warning' }">
                                        <cells>
                                            <ObjectIdentifier
                                                id="recordCell"
                                                title="{label}"
                                                text="{= ${category} === 'water' ? ${i18n>categoryWater} : ${category} === 'stock' ? ${i18n>categoryStock} : ${i18n>categoryVillage} }" />
                                            <Text id="valueCell" text="{value}" />
                                            <VBox id="changedCell" renderType="Bare">
                                                <Text id="changedAt" text="{ parts: [{ path: 'changedAt', targetType: 'any' }, 'view>/textsReady'], formatter: '.dateTimeText' }" />
                                                <ObjectStatus
                                                    id="changedBy"
                                                    text="{ parts: ['changedBy', 'view>/textsReady'], formatter: '.whoText' }"
                                                    state="{ path: 'changedBy', formatter: '.whoState' }"
                                                    icon="{ path: 'changedBy', formatter: '.whoIcon' }" />
                                            </VBox>
                                            <Text
                                                id="reasonsCell"
                                                renderWhitespace="true"
                                                text="{ parts: ['reasons', 'contradiction', 'view>/textsReady'], formatter: '.reasonsText' }" />
                                            <VBox id="markCell" renderType="Bare">
                                                <ObjectStatus id="markedStatus" visible="{marked}" text="{i18n>markedLabel}" icon="sap-icon://ti/ban" state="Error" class="ilseMarked" />
                                                <Button
                                                    id="markButton"
                                                    text="{= %{marked} ? ${i18n>unmarkButton} : ${i18n>markButton} }"
                                                    icon="{= %{marked} ? 'sap-icon://undo' : 'sap-icon://ti/ban' }"
                                                    type="{= %{marked} ? 'Default' : 'Reject' }"
                                                    press=".onToggleMark" />
                                            </VBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </IconTabFilter>

                        <!-- Every change, newest first, grouped per day: when, who, what, and why it is suspicious. -->
                        <IconTabFilter id="tabTimeline" key="timeline" icon="sap-icon://history" text="{i18n>tabTimeline}">
                            <SegmentedButton id="timelineFilter" selectedKey="all" selectionChange=".onTimelineFilter" class="ilseFilter">
                                <items>
                                    <SegmentedButtonItem id="filterAll" key="all" text="{i18n>timelineAll}" />
                                    <SegmentedButtonItem id="filterSuspicious" key="suspicious" text="{i18n>timelineSuspicious}" />
                                    <SegmentedButtonItem id="filterNight" key="night" text="{i18n>timelineNight}" />
                                </items>
                            </SegmentedButton>
                            <List
                                id="timelineList"
                                noDataText="{i18n>noTimeline}"
                                backgroundDesign="Transparent"
                                items="{ path: '/Timeline', sorter: { path: 'day', descending: true, group: true }, groupHeaderFactory: '.createGroupHeader', templateShareable: false }">
                                <items>
                                    <CustomListItem id="timelineItem" type="Inactive" highlight="{= %{suspicious} ? 'Warning' : 'None' }">
                                        <HBox id="timelineRow" renderType="Bare" class="ilseTimelineRow">
                                            <Text id="timelineTime" text="{ parts: [{ path: 'at', targetType: 'any' }, 'view>/textsReady'], formatter: '.timeText' }" class="ilseTime" />
                                            <VBox id="timelineBody" renderType="Bare" class="ilseTimelineBody">
                                                <Text id="timelineLabel" text="{label}" class="ilseStrong" />
                                                <HBox id="timelineWho" renderType="Bare" alignItems="Center" wrap="Wrap" class="ilseWho">
                                                    <Text id="timelineAction" text="{= ${action} === 'created' ? ${i18n>timelineCreated} : ${i18n>timelineModified} }" class="ilseMuted" />
                                                    <ObjectStatus
                                                        id="timelineBy"
                                                        text="{ parts: ['changedBy', 'view>/textsReady'], formatter: '.whoName' }"
                                                        state="{ path: 'changedBy', formatter: '.whoState' }"
                                                        icon="{ path: 'changedBy', formatter: '.whoIcon' }" />
                                                </HBox>
                                                <Text
                                                    id="timelineReasons"
                                                    visible="{suspicious}"
                                                    renderWhitespace="true"
                                                    text="{ parts: ['reasons', { value: null }, 'view>/textsReady'], formatter: '.reasonsText' }"
                                                    class="ilseReasons" />
                                            </VBox>
                                        </HBox>
                                    </CustomListItem>
                                </items>
                            </List>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
